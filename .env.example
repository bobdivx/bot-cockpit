# Exemples uniquement. Remplacez chaque secret avant un déploiement.
# Ne jamais coller un mot de passe de compte bot ici.

PORT=8741
NODE_ENV=production
BOT_COCKPIT_DATA=/data/cockpit.sqlite

# Jeton exigé pour créer le premier propriétaire hors boucle locale.
# Laissez vide seulement si BOT_COCKPIT_ALLOW_OPEN_SETUP=1 (développement).
BOT_COCKPIT_SETUP_TOKEN=remplacez-par-un-secret-long-et-unique

# 1 autorise la création du premier compte sans jeton. Ne pas activer en production.
BOT_COCKPIT_ALLOW_OPEN_SETUP=0

# Objet JSON nom -> URL HTTPS déjà approuvée. Pas de saisie libre dans l'interface.
# Exemple : {"demander_point":"https://exemple.invalid/routine"}
BOT_COCKPIT_WEBHOOKS={}

# Secret envoyé par le serveur, jamais saisi par un visiteur.
BOT_COCKPIT_WEBHOOK_SECRET=remplacez-par-un-autre-secret-long

# 1 autorise HTTP et les adresses privées (réseau Docker de test). Le lien local 169.254 reste bloqué.
BOT_COCKPIT_WEBHOOK_ALLOW_PRIVATE=0

# Sur Vercel, laissez BOT_COCKPIT_DATA vide : le serveur utilise /tmp/cockpit.sqlite (éphémère).
# BOT_COCKPIT_COOKIE_SECURE=1


# Turso / libSQL (obligatoire sur Vercel). Laissez vide en local pour un fichier SQLite.
# TURSO_DATABASE_URL=libsql://bot-cockpit-ORG.aws-eu-west-1.turso.io
# TURSO_AUTH_TOKEN=remplacez-par-le-jeton-de-la-base-bot-cockpit

# 0 ferme les inscriptions. Par défaut les nouveaux espaces sont ouverts.
# BOT_COCKPIT_ALLOW_SIGNUP=1
