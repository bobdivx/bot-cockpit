{
  "name": "bot-cockpit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Atelier local pour fiches de bots, imports CSV et signalements volontaires.",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n api,ui -c blue,magenta \"tsx watch src/server/index.ts\" \"vite --host 0.0.0.0 --port 8742 --strictPort\"",
    "start": "node dist/server/index.js",
    "build": "vite build && tsc -p tsconfig.server.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "lint": "biome check src tests",
    "test": "vitest run",
    "format": "biome check --write src tests"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "@libsql/client": "^0.15.15",
    "@modelcontextprotocol/server": "^2.4.0",
    "hono": "^4.13.17",
    "preact": "^11.2.0",
    "three": "^0.187.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "@modelcontextprotocol/client": "^2.4.0",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "concurrently": "^10.0.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
